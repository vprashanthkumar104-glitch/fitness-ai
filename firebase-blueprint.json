{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing identity, fitness goals, and activity streak stats.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "The unique Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "maxLength": 150,
          "description": "The user's email address."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional avatar URL."
        },
        "fitnessGoal": {
          "type": "string",
          "maxLength": 50,
          "description": "Primary fitness goal."
        },
        "fitnessLevel": {
          "type": "string",
          "maxLength": 50,
          "description": "Current fitness level."
        },
        "streakDays": {
          "type": "number",
          "description": "Consecutive days active."
        },
        "completedWorkouts": {
          "type": "number",
          "description": "Total completed workouts."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp."
        }
      },
      "required": ["userId", "email", "createdAt", "updatedAt"]
    },
    "UserSavedPlan": {
      "title": "UserSavedPlan",
      "description": "A saved workout or nutrition plan generated by the AI assistants.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Unique plan ID."
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Owner Auth UID."
        },
        "featureId": {
          "type": "string",
          "maxLength": 64,
          "description": "The AI feature key."
        },
        "title": {
          "type": "string",
          "maxLength": 128,
          "description": "Headline of the plan."
        },
        "category": {
          "type": "string",
          "maxLength": 64,
          "description": "Category such as Training or Nutrition."
        },
        "content": {
          "type": "string",
          "maxLength": 5000,
          "description": "Structured details of the generated plan."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        }
      },
      "required": ["id", "userId", "title", "content", "createdAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Inbound support inquiry submitted via the Contact page.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Unique message ID."
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Sender name."
        },
        "email": {
          "type": "string",
          "maxLength": 150,
          "description": "Sender email."
        },
        "subject": {
          "type": "string",
          "maxLength": 150,
          "description": "Subject of the message."
        },
        "message": {
          "type": "string",
          "maxLength": 2000,
          "description": "Body of the message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when submitted."
        },
        "status": {
          "type": "string",
          "enum": ["unread", "read", "archived"],
          "description": "Status of the message."
        }
      },
      "required": ["id", "name", "email", "subject", "message", "createdAt", "status"]
    },
    "KnowledgeDocument": {
      "title": "KnowledgeDocument",
      "description": "Uploaded fitness reference documents (PDF, DOC, DOCX, TXT) prepared for RAG pipeline ingestion.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Unique document identifier."
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Owner user ID or guest."
        },
        "name": {
          "type": "string",
          "maxLength": 255,
          "description": "Original filename."
        },
        "fileType": {
          "type": "string",
          "enum": ["pdf", "doc", "docx", "txt"],
          "description": "File extension."
        },
        "mimeType": {
          "type": "string",
          "maxLength": 128,
          "description": "MIME type."
        },
        "fileSize": {
          "type": "number",
          "description": "File size in bytes."
        },
        "formattedSize": {
          "type": "string",
          "maxLength": 32,
          "description": "Formatted file size (e.g., 1.5 MB)."
        },
        "uploadedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO upload timestamp."
        },
        "status": {
          "type": "string",
          "enum": ["ready", "processing", "indexed"],
          "description": "RAG indexing status."
        },
        "contentPreview": {
          "type": "string",
          "maxLength": 2000,
          "description": "Extracted text preview snippet."
        },
        "charCount": {
          "type": "number",
          "description": "Extracted character count."
        },
        "wordCount": {
          "type": "number",
          "description": "Extracted word count."
        }
      },
      "required": ["id", "name", "fileType", "fileSize", "uploadedAt", "status"]
    },
    "KnowledgeChunk": {
      "title": "KnowledgeChunk",
      "description": "Text chunk extracted from uploaded fitness documents with vector embedding and metadata for RAG search.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "docId": {
          "type": "string",
          "maxLength": 128
        },
        "docName": {
          "type": "string",
          "maxLength": 255
        },
        "chunkIndex": {
          "type": "number"
        },
        "text": {
          "type": "string",
          "maxLength": 3000
        },
        "charCount": {
          "type": "number"
        },
        "wordCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "docId", "docName", "chunkIndex", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profiles keyed by their Auth UID."
    },
    "/users/{userId}/saved_plans/{planId}": {
      "schema": "UserSavedPlan",
      "description": "Subcollection storing user-saved AI workouts and plans."
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Public contact messages submitted by visitors."
    },
    "/knowledge_documents/{docId}": {
      "schema": "KnowledgeDocument",
      "description": "Fitness reference documents uploaded for RAG pipeline ingestion."
    },
    "/knowledge_chunks/{chunkId}": {
      "schema": "KnowledgeChunk",
      "description": "Text chunks and embeddings for RAG vector search."
    }
  }
}
